#!/usr/bin/env bash
set -euo pipefail

which gh >/dev/null || brew install gh

if [ "$1" == "nightly" ]; then
  ./script/bump-nightly
  exit
fi

if [ "$1" == "stable" ]; then
  # main is this fork's release branch - no separate vX.Y.x branch to keep in sync.
  branch="main"
else
  version=$(./script/get-released-version "$1" | sed 's/\.[^\.]*$/.x/')
  branch="v$version"
fi
echo "Bumping $1 ($branch)"

gh workflow run "bump_patch_version.yml" -f branch="$branch"
repo_url=$(gh repo view --json url -q .url)
echo "Follow along at: $repo_url/actions"
